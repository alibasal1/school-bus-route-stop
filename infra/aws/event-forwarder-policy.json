{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishRouteEventsOnly",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:000000000000:school-bus-route-events"
    },
    {
      "Sid": "WriteItsOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/route-stop-event-forwarder:*"
    }
  ]
}
