# Copy this file to .env and fill in real values. Never commit .env.
# The same names are set in the Vercel dashboard (Settings > Environment
# Variables), where they are stored encrypted and handed to the function at
# runtime. Nothing secret ever reaches GitHub.

# --- core --------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Neon connection string. Anyone holding this can read and delete every route,
# stop and trip, so treat it like a password: never in code, a screenshot, a
# chat or a commit. If it leaks, reset the role password in Neon and update
# both .env and the Vercel dashboard.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Comma-separated list of browser origins allowed to call this API.
# Scheme + host + port, no trailing slash, no path.
# Local React dev server, then the deployed frontend:
CORS_ORIGINS=http://localhost:5173,https://school-bus-frontend.vercel.app

# --- internal endpoints ------------------------------------------------------
# Shared secret for /api/internal/* : the scheduled trip generator and the
# event forwarder present it in the X-Internal-Key header. These callers have
# no login, so this is their only credential. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# At least 32 characters, or the internal routes refuse to run.
INTERNAL_API_KEY=

# --- Upstash Redis (rate limiting) -------------------------------------------
# Free plan, REST API, no npm package needed. Without these the service falls
# back to an in-memory counter, which is per-instance and therefore only
# suitable for local development. See docs/cloud-services.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (bot protection on writes) -------------------------
# Secret key only; the site key belongs in the frontend and is public.
# Leave empty to disable the check locally. Cloudflare's always-passing test
# secret for local work is 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
