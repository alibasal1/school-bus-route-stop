# Copy this file to .env and fill it in. Never commit .env.
# On Lambda these are set by infra/deploy.sh as function settings; nothing
# secret is among them, because DynamoDB access comes from the IAM role
# rather than from a connection string the code holds.

# --- core --------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Floci. Leave empty to talk to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_PROFILE=floci

# Browser origins allowed to call this API. Scheme + host + port, no
# trailing slash, comma separated.
CORS_ORIGINS=http://localhost:5173

# Ali's queue. Send only; this service never reads it.
ALERTS_QUEUE_URL=http://localhost:4566/000000000000/favorites-alerts-queue

# --- internal endpoints ------------------------------------------------------
# Shared secret for /api/internal/*: the scheduled run presents it in the
# X-Internal-Key header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# At least 32 characters, or the internal routes refuse to run.
INTERNAL_API_KEY=

# --- Cloudflare Turnstile (optional) -----------------------------------------
# Secret key only; the site key belongs in the frontend and is public.
# Left empty, the bot check is skipped and that is logged as a SECURITY line.
TURNSTILE_SECRET_KEY=

# --- Secrets Manager (optional, Lambda only) ---------------------------------
# The NAME of the secret holding TURNSTILE_SECRET_KEY and INTERNAL_API_KEY.
# The name is not itself secret.
SECRET_ID=
