{
  "name": "route-stop-api",
  "version": "1.0.0",
  "private": true,
  "description": "Route & Stop service for the School Bus Route Tracker (26CSCN29H, Team 14).",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test tests/unit/*.test.js && jest --runInBand",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:api": "jest --runInBand",
    "zip": "node scripts/zip.js",
    "deploy": "bash infra/deploy.sh",
    "seed": "node scripts/seed-floci.js",
    "cleanup": "node scripts/cleanup-test-data.js",
    "test:watch": "node --test --watch tests/unit/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.682.0",
    "@aws-sdk/client-secrets-manager": "^3.682.0",
    "@aws-sdk/client-sqs": "^3.682.0",
    "@aws-sdk/lib-dynamodb": "^3.682.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/api/**/*.test.js"
    ]
  }
}
